// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId Int @id @default(autoincrement()) @map("user_id")
  email String @unique @db.VarChar(30)
  password String @db.VarChar(100)
  name String @db.VarChar(30)
  status UserStatus @default(active)
  role Role @default(user)
  cart Cart?
  orders Order[]
  productsForSale Product[]
  wishlist Wishlist?

  @@map("users")
}

enum Role {
  user
  seller
  admin
}

enum UserStatus {
  active
  blocked
}

model Product {
  productId Int @id @default(autoincrement()) @map("product_id")
  name String @db.VarChar(150)
  price Decimal @db.Decimal(10, 2)
  sellerId Int @map("seller_id")
  seller User @relation(fields: [sellerId], references: [userId])
  discount Discount?
  productImages ProductImages[]
  productDetails ProductDetails?
  orderItem OrderItem?
  cartItems CartItem?
  wishlist Wishlist?

  @@unique([sellerId, name])
  @@map("products")
}

model ProductDetails {
  productId Int @id @map("product_id")
  product Product @relation(fields: [productId], references: [productId])
  color String?
  size String?
  author String?
  description String?
  category ProductCategory?

  @@map("product_details")
}

model ProductImages {
  productId Int @unique @map("product_id")
  imagePath String @map("image_path")
  product Product @relation(fields: [productId], references: [productId])
}

enum ProductCategory {
  gadgets
  clothes
  books
}

model Cart {
  cartId Int @id @default(autoincrement()) @map("cart_id")
  token String @unique @default(uuid())
  userId Int? @unique @map("user_id")
  user User? @relation(references: [userId], fields: [userId])
  items CartItem[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime? @map("expires_at")

  @@map("carts")
}

model CartItem {
  cartItemId Int @id @default(autoincrement()) @map("cart_item_id")

  cartId Int @map("cart_id")
  productId Int @unique @map("product_id")

  quantity Int @default(1)

  cart Cart @relation(fields: [cartId], references: [cartId])
  product Product @relation(fields: [productId], references: [productId])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  orderId Int @id @default(autoincrement()) @map("order_id")

  userId Int? @map("user_id")
  user User? @relation(fields: [userId], references: [userId])

  customerName String @map("customer_name") @db.VarChar(100)
  customerEmail String @map("customer_email") @db.VarChar(150)
  customerPhone String? @map("customer_phone") @db.VarChar(30)

  deliveryAddress String? @map("delivery_address") @db.VarChar(500)
  status OrderStatus @default(unpaid)
  paymentStatus PaymentStatus @default(pending) @map("payment_status")

  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  orderItems OrderItem[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  orderItemId Int @id @default(autoincrement()) @map("order_item_id")

  orderId Int @unique @map("order_id")
  productId Int @unique @map("product_id")

  quantity Int @default(1)

  productPrice Decimal @db.Money() @map("product_price")
  totalPrice Decimal @db.Money() @map("total_price")

  order Order @relation(fields: [orderId], references: [orderId])
  product Product @relation(fields: [productId], references: [productId])

  productName String @map("product_name") @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Discount {
  productId Int @unique
  discount Decimal
  product Product @relation(fields: [productId], references: [productId])

  @@map("discounts")
}

model Wishlist {
  productId Int @unique
  userId Int @unique
  product Product @relation(fields: [productId], references: [productId])
  user User @relation(fields: [userId], references: [userId])
}

enum OrderStatus {
  unpaid
  paid
  refund
  part_refund
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}